{
	"pages": [
		{ "name": "index", "path": "pages/index/index" }
	],
	"subPackages": [
		{
			"root": "packWallpaper",
			"pages": [
				{ "name": "imageList", "path": "pages/common/imageList", "style": { "navigationBarTitleText": "图片列表" } },
				{ "name": "imageDetail", "path": "pages/common/imageDetail", "style": { "navigationBarTitleText": "图片详情" } },
				{ "name": "albumIndex", "path": "pages/album/index", "style": { "navigationBarTitleText": "壁纸专辑" } },
				{ "name": "albumDetails", "path": "pages/album/details", "style": { "navigationBarTitleText": "专辑详情" } },
				{ "name": "textList", "path": "pages/text/index", "style": { "navigationBarTitleText": "文案" } },
				{ "name": "textDetails", "path": "pages/text/details", "style": { "navigationBarTitleText": "文案详情" } },
				{ "name": "wallpaperSearch", "path": "pages/search/index", "style": { "navigationBarTitleText": "搜索" } },
				{ "name": "wallpaperSearchList", "path": "pages/search/list", "style": { "navigationBarTitleText": "搜索结果" } }
			]
		},
		{
			"root": "packPublic",
			"pages": [
				{ "name": "aboutUs", "path": "pages/aboutUs/index", "style": { "navigationBarTitleText": "关于我们", "navigationStyle": "custom" } },
				{ "name": "feedback", "path": "pages/feedback/index", "style": { "navigationBarTitleText": "我要吐槽", "navigationStyle": "default" } },
				{ "name": "question", "path": "pages/question/index", "style": { "navigationBarTitleText": "常见问题", "navigationStyle": "custom" } },
				{ "name": "richText", "path": "pages/richText/index", "style": { "navigationBarTitleText": "", "navigationStyle": "custom" } }
			]
		},
		{
			"root": "packUser",
			"pages": [
				{ "name": "userProfile", "path": "pages/profile/index", "style": { "navigationBarTitleText": "编辑资料" } },
				{ "name": "redeemCode", "path": "pages/redeemCode/index", "style": { "navigationBarTitleText": "卡密兑换" } },
				{ "name": "userDownload", "path": "pages/download/index", "style": { "navigationBarTitleText": "我的下载" } },
				{ "name": "userCollect", "path": "pages/collect/index", "style": { "navigationBarTitleText": "我的收藏" } }
			]
		}
	],
	"preloadRule": {
		"pages/index/index": {
			"network": "all",
			"packages": ["packWallpaper"]
		}
	},
	"easycom": {
		"autoscan": true,
		"custom": {
			"^app-(.*)": "@/components/app-$1/app-$1.vue",
			"^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
			"^u--(.*)": "uview-plus/components/u-$1/u-$1.vue"
		}
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "TinyWuYou-壁纸",
		"navigationBarBackgroundColor": "#FFFFFF",
		"backgroundColor": "#F8F8F8",
		"navigationStyle": "custom"
	},
	"uniIdRouter": {}
}
